# CP2 — Files excluded from Docker build context
# Prevent secrets, unnecessary files, and bloat from entering the image

.env
.env.example
.git
.gitignore
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
tests/
screenshots/
nginx/
*.md
!requirements.txt
.dockerignore
.github
grade.py
railway.toml
render.yaml
